# GhostTrade Environment Variables
# Copy this to .env and fill in your values

# === AI Engine ===
GEMINI_API_KEY=your_gemini_api_key_here

# === Database (MongoDB Atlas recommended) ===
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ghosttrade?retryWrites=true&w=majority
MONGODB_DB_NAME=ghosttrade

# === Security ===
JWT_SECRET=generate_a_strong_random_secret_here

# === Discord Alerts (optional) ===
DISCORD_API=https://discord.com/api/webhooks/your_webhook_url_here
