# =====================================================
# GHOSTTRADE ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =====================================================

# === RUNTIME MODE ===
# Set to 'production' for strict security enforcement.
# When 'production': missing secrets = server crash.
# When 'development': missing secrets = warning only.
NODE_ENV=development

# === CORE SECRETS (REQUIRED) ===
# Generate with: openssl rand -hex 32
JWT_SECRET=<generate-64-char-hex-string>

# Encryption key for broker API credentials at rest (AES-256-GCM)
# Generate with: openssl rand -hex 32
# WARNING: Changing this will invalidate all stored broker keys.
BROKER_ENCRYPTION_KEY=<generate-64-char-hex-string>

# === DATABASE (REQUIRED) ===
# MongoDB Atlas URI with TLS. For local dev: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ghosttrade

# === AI ENGINE (REQUIRED) ===
GEMINI_API_KEY=<your-google-gemini-api-key>

# === FRONTEND URL (REQUIRED IN PRODUCTION) ===
# Used for CORS origin whitelisting.
# Development: http://localhost:5173
# Production: https://your-domain.com
FRONTEND_URL=http://localhost:5173

# === BILLING (OPTIONAL — Paddle) ===
PADDLE_API_KEY=
PADDLE_CLIENT_SIDE_TOKEN=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=

# === BROKER OAUTH (OPTIONAL — Live Trading) ===
ALPACA_CLIENT_ID=
ALPACA_CLIENT_SECRET=

BINANCE_CLIENT_ID=
BINANCE_CLIENT_SECRET=

IBKR_CLIENT_ID=
IBKR_CLIENT_SECRET=

# === NOTIFICATIONS (OPTIONAL) ===
DISCORD_API=<discord-webhook-url>
